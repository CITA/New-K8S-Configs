10. CHECK WORDPRESS
-------------------

WEB=$(kubectl get pod \
    -n cita-site-website \
    -l app=cita-site-website \
    -o jsonpath='{.items[0].metadata.name}')

kubectl exec \
    -n cita-site-website \
    "$WEB" \
    -c web -- \
    php /usr/share/wordpress/wp-cli.phar \
    --path=/usr/share/wordpress \
    --allow-root \
    option get home

kubectl exec \
    -n cita-site-website \
    "$WEB" \
    -c web -- \
    php /usr/share/wordpress/wp-cli.phar \
    --path=/usr/share/wordpress \
    --allow-root \
    option get siteurl

Expected:

    https://www.cita.utoronto.ca


